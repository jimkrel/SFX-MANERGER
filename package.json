{
  "name": "sfx-music-manager",
  "version": "1.0.0",
  "description": "Local SFX & Music Manager for macOS",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "test:phase1": "ELECTRON_RUN_AS_NODE=1 electron scripts/test-phase1.mjs",
    "test:phase2": "ELECTRON_RUN_AS_NODE=1 electron scripts/test-phase2.mjs",
    "test:phase3": "ELECTRON_RUN_AS_NODE=1 electron scripts/test-phase3.mjs",
    "test:phase4": "ELECTRON_RUN_AS_NODE=1 electron scripts/test-phase4.mjs",
    "test:phase5": "ELECTRON_RUN_AS_NODE=1 electron scripts/test-phase5.mjs",
    "test:phase6": "ELECTRON_RUN_AS_NODE=1 electron scripts/test-phase6.mjs",
    "test:dragdrop": "ELECTRON_RUN_AS_NODE=1 electron scripts/test-drag-drop.mjs",
    "test": "npm run test:phase1 && npm run test:phase2 && npm run test:phase3 && npm run test:phase4 && npm run test:phase5 && npm run test:phase6 && npm run test:dragdrop",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "chokidar": "^4.0.3",
    "music-metadata": "^11.15.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  }
}
